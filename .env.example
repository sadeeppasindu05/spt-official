# =============================================================================
# SPT OFFICIAL - Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================================

# --- Gemini AI API ---
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# --- Supabase Configuration ---
# Find these in your Supabase project dashboard: Settings > API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# --- Supabase Service Role Key (SERVER-SIDE ONLY!) ---
# Found in Supabase: Settings > API > service_role key
# WARNING: NEVER expose this to the client. Server-side use only.
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"

# --- Email (Gmail SMTP for OTP) ---
GMAIL_EMAIL="sadeeppasindu0218@gmail.com"
# Generate an App Password: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD="your_gmail_app_password_here"

# --- Admin API Token ---
# Used to protect admin API endpoints on the server.
# Generate a strong random token: openssl rand -hex 32
ADMIN_API_TOKEN="your_secure_admin_api_token_here"

# --- App Configuration ---
APP_URL="http://localhost:3000"
PORT=3000

# --- Hugging Face Space ---
# The Hugging Face Space ID (set automatically in HF Spaces)
SPACE_ID="Sadeeppasindu05/spt-official"

# --- Supabase Service Role Key (used for admin operations like deleting users from Auth) ---
VITE_SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"
